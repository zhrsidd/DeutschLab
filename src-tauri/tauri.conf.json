{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeutschLab",
  "version": "1.0.0",
  "identifier": "com.deutschlab.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeutschLab",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#090909",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBM0Q4NkY2QTRDMDY0QjUKUldTMVpNQ2s5b1k5S3JncHNuQlpsTngzT05UdHZqVUg2ZDdOTHdDbVh6RjZZQStJVlEzc3RRbWcK",
      "endpoints": [
        "https://github.com/zhrsidd/DeutschLab/releases/latest/download/latest.json"
      ]
    }
  }
}
